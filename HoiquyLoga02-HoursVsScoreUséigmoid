import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

# 1. Định nghĩa hàm Sigmoid với L được cố định là 100
# Bây giờ máy chỉ cần tìm x0 (điểm uốn) và k (độ dốc)
def sigmoid_fixed(x, x0, k):
    return 100 / (1 + np.exp(-k * (x - x0)))

# 2. Dữ liệu mẫu (giữ nguyên)
x_data = np.array([1, 2, 5, 10, 20, 40, 60, 80, 100])
y_data = np.array([10, 25, 45, 60, 72, 82, 88, 92, 95])

# 3. Huấn luyện mô hình (Chỉ tìm x0 và k)
# p0 là gợi ý ban đầu cho máy tính
popt, pcov = curve_fit(sigmoid_fixed, x_data, y_data, p0=[10, 0.1])

# 4. Dự đoán với các mốc giờ cực lớn
x_test = np.array([101, 102, 105, 110])
y_pred = sigmoid_fixed(x_test, *popt)

print(f"Dự đoán 101 giờ: {y_pred[0]:.2f} điểm")
print(f"Dự đoán 102 giờ: {y_pred[1]:.2f} điểm")
print(f"Dự đoán 105 giờ: {y_pred[2]:.2f} điểm")
print(f"Dự đoán 110 giờ: {y_pred[3]:.2f} điểm")

# 5. Vẽ đồ thị
plt.figure(figsize=(10, 6))
plt.scatter(x_data, y_data, color='blue', label='Dữ liệu thực tế')

# Vẽ đường cong tiệm cận đến 100
x_curve = np.linspace(0, 1000, 2000)
y_curve = sigmoid_fixed(x_curve, *popt)

plt.plot(x_curve, y_curve, color='red', label='Đường cong tiệm cận ngang y=100')
plt.axhline(y=100, color='black', linestyle='--', alpha=0.5, label='Ngưỡng tuyệt đối 100')

plt.ylim(0, 110) # Để nhìn thấy cái ngưỡng 100 rõ hơn
plt.xlabel('Số giờ học')
plt.ylabel('Điểm số')
plt.title('Hồi quy Sigmoid với Tiệm cận ngang cố định tại 100')
plt.legend()
plt.grid(True, alpha=0.2)
plt.show()
